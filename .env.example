# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env

# TMDB API settings
TMDB_API_TOKEN=your_tmdb_api_token
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=ru-RU

# Database settings
DB_URL=sqlite+aiosqlite:///tenkino.db
GENAPI_TOKEN=your_genapi_token

# Telegram bot settings
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHANNEL_ID=your_channel_username

# Scheduler settings
TZ_OFFSET=0
GEMS_HOUR=18
GEMS_MINUTE=0
ACTORS_DAYS=mon,thu
ACTORS_HOUR=18
ACTORS_MINUTE=0
